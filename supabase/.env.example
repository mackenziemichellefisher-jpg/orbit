# Copy to supabase/.env and fill in. supabase/.env is git-ignored.
# These feed the env(...) references in supabase/config.toml.

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Twilio Console > Account info, and Messaging > Services
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
